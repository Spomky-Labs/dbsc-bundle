{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block page_title 'DBSC' %}

{% macro kv(map) %}
    <table>
        <tbody>
            {% for key, value in map %}
                <tr>
                    <th scope="row" class="key">{{ key }}</th>
                    <td>{% if value is iterable %}<code>{{ value|json_encode(constant('JSON_UNESCAPED_SLASHES')) }}</code>{% elseif value is same as(true) %}true{% elseif value is same as(false) %}false{% elseif value is null %}null{% else %}{{ value }}{% endif %}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}

{% block toolbar %}
    {% set endpoint = collector.endpoint %}
    {% set icon %}
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="24" height="24"><defs><radialGradient id="dbsc-dough" cx=".4" cy=".35" r=".75"><stop offset="0" stop-color="#cfcfcf"/><stop offset="1" stop-color="#8a8a8a"/></radialGradient><radialGradient id="dbsc-chip" cx=".4" cy=".35" r=".8"><stop offset="0" stop-color="#6a6a6a"/><stop offset="1" stop-color="#3a3a3a"/></radialGradient><radialGradient id="dbsc-badge" cx=".4" cy=".35" r=".9"><stop offset="0" stop-color="#565656"/><stop offset="1" stop-color="#202020"/></radialGradient><mask id="dbsc-bite"><rect width="48" height="48" fill="#fff"/><circle cx="30" cy="8" r="4" fill="#000"/><circle cx="34" cy="11" r="3.4" fill="#000"/><circle cx="32" cy="13.5" r="2.6" fill="#000"/><circle cx="36.5" cy="15.5" r="2.4" fill="#000"/></mask></defs><circle cx="20" cy="20" r="15" fill="url(#dbsc-dough)" stroke="#6f6f6f" stroke-width=".5" mask="url(#dbsc-bite)"/><g fill="url(#dbsc-chip)"><circle cx="13" cy="15" r="2"/><circle cx="22" cy="12" r="1.4"/><circle cx="12" cy="23" r="1.7"/><circle cx="18" cy="26" r="1.9"/><circle cx="24" cy="19" r="1.6"/><circle cx="15" cy="20" r="1.3"/></g><circle cx="35" cy="35" r="8" fill="url(#dbsc-badge)" stroke="#ededed" stroke-opacity=".5" stroke-width=".6"/><path d="M32 34v-2a3 3 0 0 1 6 0v2" fill="none" stroke="#ededed" stroke-width="1.4"/><rect x="31.5" y="34" width="7" height="6" rx="1.3" fill="#ededed"/><circle cx="35" cy="36.4" r=".9" fill="#2a2a2a"/><rect x="34.6" y="36.4" width=".8" height="2.1" rx=".4" fill="#2a2a2a"/></svg>
        </span>
        <span class="sf-toolbar-value">DBSC</span>
        {% if endpoint %}
            <span class="sf-toolbar-label">{{ endpoint.type }}</span>
        {% endif %}
    {% endset %}

    {% set text %}
        {% if endpoint %}
            <div class="sf-toolbar-info-piece">
                <b>Endpoint</b>
                <span><code>{{ endpoint.type }}</code> ({{ endpoint.firewall }})</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Outcome</b>
                <span class="sf-toolbar-status sf-toolbar-status-{{ endpoint.status < 400 ? 'green' : 'red' }}">{{ endpoint.outcome }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Status</b>
                <span>{{ endpoint.status }}</span>
            </div>
        {% endif %}
        <div class="sf-toolbar-info-piece">
            <b>Registration requested</b>
            <span class="sf-toolbar-status sf-toolbar-status-{{ collector.registrationRequested ? 'green' : 'normal' }}">{{ collector.registrationRequested ? 'yes' : 'no' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Device-bound cookie</b>
            <span class="sf-toolbar-status sf-toolbar-status-{{ collector.cookiePresent ? 'green' : 'normal' }}">{{ collector.cookiePresent ? 'present' : 'absent' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Firewalls</b>
            <span>{{ collector.data.firewalls|keys|join(', ') ?: '(none)' }}</span>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: true }) }}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.registrationRequested or collector.cookiePresent or collector.endpoint ? '' : 'disabled' }}">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="24" height="24"><defs><radialGradient id="dbsc-dough-m" cx=".4" cy=".35" r=".75"><stop offset="0" stop-color="#cfcfcf"/><stop offset="1" stop-color="#8a8a8a"/></radialGradient><radialGradient id="dbsc-chip-m" cx=".4" cy=".35" r=".8"><stop offset="0" stop-color="#6a6a6a"/><stop offset="1" stop-color="#3a3a3a"/></radialGradient><radialGradient id="dbsc-badge-m" cx=".4" cy=".35" r=".9"><stop offset="0" stop-color="#565656"/><stop offset="1" stop-color="#202020"/></radialGradient><mask id="dbsc-bite-m"><rect width="48" height="48" fill="#fff"/><circle cx="30" cy="8" r="4" fill="#000"/><circle cx="34" cy="11" r="3.4" fill="#000"/><circle cx="32" cy="13.5" r="2.6" fill="#000"/><circle cx="36.5" cy="15.5" r="2.4" fill="#000"/></mask></defs><circle cx="20" cy="20" r="15" fill="url(#dbsc-dough-m)" stroke="#6f6f6f" stroke-width=".5" mask="url(#dbsc-bite-m)"/><g fill="url(#dbsc-chip-m)"><circle cx="13" cy="15" r="2"/><circle cx="22" cy="12" r="1.4"/><circle cx="12" cy="23" r="1.7"/><circle cx="18" cy="26" r="1.9"/><circle cx="24" cy="19" r="1.6"/><circle cx="15" cy="20" r="1.3"/></g><circle cx="35" cy="35" r="8" fill="url(#dbsc-badge-m)" stroke="#ededed" stroke-opacity=".5" stroke-width=".6"/><path d="M32 34v-2a3 3 0 0 1 6 0v2" fill="none" stroke="#ededed" stroke-width="1.4"/><rect x="31.5" y="34" width="7" height="6" rx="1.3" fill="#ededed"/><circle cx="35" cy="36.4" r=".9" fill="#2a2a2a"/><rect x="34.6" y="36.4" width=".8" height="2.1" rx=".4" fill="#2a2a2a"/></svg>
        </span>
        <strong>DBSC</strong>
        {% if collector.endpoint %}
            <span class="count"><span>{{ collector.endpoint.type }}</span></span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    {% import _self as helper %}
    {% set endpoint = collector.endpoint %}
    <h2>Device Bound Session Credentials</h2>

    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.registrationRequested ? 'Yes' : 'No' }}</span>
            <span class="label">Registration requested</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.cookiePresent ? 'Present' : 'Absent' }}</span>
            <span class="label">Device-bound cookie</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.data.firewalls|length }}</span>
            <span class="label">Firewalls with DBSC</span>
        </div>
        <div class="metric">
            <span class="value">{{ endpoint ? endpoint.type : '—' }}</span>
            <span class="label">Endpoint hit this request</span>
        </div>
    </div>

    <div class="sf-tabs">
        <div class="tab {{ endpoint ? '' : 'disabled' }}">
            <h3 class="tab-title">Endpoint activity{% if endpoint %} <span class="badge">{{ endpoint.type }}</span>{% endif %}</h3>
            <div class="tab-content">
                {% if endpoint %}
                    <p>
                        Request to the <strong>{{ endpoint.type }}</strong> endpoint on firewall
                        <code>{{ endpoint.firewall }}</code>, answered
                        <span class="label {{ endpoint.status < 400 ? 'status-success' : 'status-error' }}">{{ endpoint.outcome }}</span>
                        (HTTP {{ endpoint.status }}).
                    </p>
                    <table>
                        <tbody>
                            <tr><th>Path</th><td><code>{{ endpoint.path }}</code></td></tr>
                            {% if endpoint.type == 'refresh' %}
                                <tr><th>Phase</th><td>{{ endpoint.phase == 'challenge_request' ? 'challenge request (no proof)' : 'proof submission' }}</td></tr>
                                <tr><th>Session id (Sec-Secure-Session-Id)</th><td>{{ endpoint.session_id ? ('<code>' ~ endpoint.session_id ~ '</code>')|raw : '(none)' }}</td></tr>
                                <tr><th>Challenge issued</th><td>{{ endpoint.challenge ? ('<code>' ~ endpoint.challenge ~ '</code>')|raw : '(none)' }}</td></tr>
                            {% endif %}
                            <tr><th>Proof submitted</th><td>{{ endpoint.had_proof ? 'yes (Secure-Session-Response)' : 'no' }}</td></tr>
                            <tr>
                                <th>Bound cookie</th>
                                <td>
                                    {% if endpoint.cookie_cleared %}cleared (session terminated)
                                    {% elseif endpoint.cookie_set %}set / rotated — <code>{{ endpoint.cookie_preview }}</code>
                                    {% else %}(unchanged){% endif %}
                                </td>
                            </tr>
                            {% if endpoint.error %}
                                <tr><th>Error</th><td><code>{{ endpoint.error }}</code></td></tr>
                            {% endif %}
                        </tbody>
                    </table>

                    {% if endpoint.proof_header or endpoint.proof_payload %}
                        <h4>Submitted proof <small>(JWS — decoded for display, signature not verified)</small></h4>
                        {% if endpoint.proof_header %}
                            <h5>Header</h5>
                            {{ helper.kv(endpoint.proof_header) }}
                        {% endif %}
                        {% if endpoint.proof_payload %}
                            <h5>Payload</h5>
                            {{ helper.kv(endpoint.proof_payload) }}
                        {% endif %}
                    {% endif %}

                    {% if endpoint.session_config %}
                        <h4>Issued session configuration <small>(response body)</small></h4>
                        {{ helper.kv(endpoint.session_config) }}
                    {% endif %}
                {% else %}
                    <div class="empty">
                        <p>This request did not hit a registration or refresh endpoint.</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="tab">
            <h3 class="tab-title">Login registration</h3>
            <div class="tab-content">
                {% if collector.registrationRequested %}
                    <p>This response asked the browser to register a device-bound key.</p>
                {% else %}
                    <p>This response did not emit a <code>Secure-Session-Registration</code> header.</p>
                {% endif %}
                <table>
                    <tbody>
                        <tr>
                            <th>Registration header</th>
                            <td>{{ collector.registrationHeader ? ('<code>' ~ collector.registrationHeader ~ '</code>')|raw : '(none)' }}</td>
                        </tr>
                        {% if collector.data.registration %}
                            <tr><th>Offered algorithms</th><td>{{ collector.data.registration.algorithms|join(', ') ?: '(none)' }}</td></tr>
                            <tr><th>Challenge</th><td>{{ collector.data.registration.challenge ?? '(none)' }}</td></tr>
                            <tr><th>Registration path</th><td>{{ collector.data.registration.path ? ('<code>' ~ collector.data.registration.path ~ '</code>')|raw : '(none)' }}</td></tr>
                            <tr><th>Authorization</th><td>{{ collector.data.registration.authorization ?? '(none)' }}</td></tr>
                        {% else %}
                            <tr><th>Challenge</th><td>(none)</td></tr>
                        {% endif %}
                        <tr>
                            <th>Skipped header (Secure-Session-Skipped)</th>
                            <td>{{ collector.data.skipped ? ('<code>' ~ collector.data.skipped ~ '</code>')|raw : '(none)' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab {{ collector.data.firewalls is empty ? 'disabled' : '' }}">
            <h3 class="tab-title">Firewalls &amp; configuration <span class="badge">{{ collector.data.firewalls|length }}</span></h3>
            <div class="tab-content">
                {% if collector.data.firewalls is empty %}
                    <div class="empty">
                        <p>No firewall enables <code>device_bound_session</code>.</p>
                    </div>
                {% endif %}

                {% for name, firewall in collector.data.firewalls %}
                    <h4>Firewall <code>{{ name }}</code></h4>
                    <table>
                        <thead><tr><th scope="col" class="key" style="width: 220px;">Option</th><th scope="col">Value</th></tr></thead>
                        <tbody>
                            <tr>
                                <th>Mode</th>
                                <td>{{ firewall.authenticate ? 'full replacement — authenticates from the bound cookie (remember-me replacement)' : 'additive — keeps the existing authentication' }}</td>
                            </tr>
                            <tr>
                                <th>Registration trigger</th>
                                <td>{{ firewall.always ? 'always (every login)' : ('opt-in via checkbox <code>' ~ firewall.checkbox ~ '</code>')|raw }}</td>
                            </tr>
                            <tr><th>Registration endpoint</th><td><code>{{ firewall.register_path }}</code></td></tr>
                            <tr><th>Refresh endpoint</th><td><code>{{ firewall.refresh_path }}</code></td></tr>
                            <tr><th>Algorithms</th><td>{{ firewall.algorithms|join(', ') }}</td></tr>
                            <tr><th>Challenge TTL</th><td>{{ firewall.challenge_ttl }} s</td></tr>
                            <tr><th>Session lifetime</th><td>{{ firewall.session_lifetime is null ? 'never expires' : firewall.session_lifetime ~ ' s' }}</td></tr>
                            <tr><th>Session scope</th><td>{{ firewall.include_site ? 'site-scoped (include_site)' : 'origin-scoped' }}</td></tr>
                            <tr>
                                <th>Scope excluded paths</th>
                                <td>{{ firewall.scope_exclude_paths is empty ? '(none)' : firewall.scope_exclude_paths|join(', ') }}</td>
                            </tr>
                            <tr>
                                <th>Allowed refresh initiators</th>
                                <td>{{ firewall.allowed_refresh_initiators is empty ? '(none)' : firewall.allowed_refresh_initiators|join(', ') }}</td>
                            </tr>
                            <tr>
                                <th>Binding repository</th>
                                <td>
                                    <code>{{ firewall.binding_repository ?? '(n/a)' }}</code>
                                    {{ firewall.binding_repository_service is null ? '(in-memory)' : '(persistent)' }}
                                </td>
                            </tr>
                            <tr>
                                <th>Challenge store</th>
                                <td>
                                    <code>{{ firewall.challenge_store ?? '(n/a)' }}</code>
                                    {{ firewall.challenge_store_service is null ? '(in-memory)' : '(persistent)' }}
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table>
                        <thead><tr><th scope="col" class="key" style="width: 220px;">Bound cookie</th><th scope="col">Value</th></tr></thead>
                        <tbody>
                            <tr><th>Name</th><td><code>{{ firewall.cookie.name }}</code></td></tr>
                            <tr><th>Present on this request</th><td>{{ firewall.cookie_present ? firewall.cookie_preview : '(not sent)' }}</td></tr>
                            {% if firewall.cookie.lifetime is defined %}
                                <tr><th>Lifetime</th><td>{{ firewall.cookie.lifetime }} s</td></tr>
                                <tr><th>Path</th><td><code>{{ firewall.cookie.path }}</code></td></tr>
                                <tr><th>Domain</th><td>{{ firewall.cookie.domain ?? '(none)' }}</td></tr>
                                <tr><th>Secure</th><td>{{ firewall.cookie.secure ? 'yes' : 'no' }}</td></tr>
                                <tr><th>HttpOnly</th><td>{{ firewall.cookie.http_only ? 'yes' : 'no' }}</td></tr>
                                <tr><th>SameSite</th><td>{{ firewall.cookie.same_site }}</td></tr>
                            {% endif %}
                        </tbody>
                    </table>

                    {% if firewall.binding_jwk is not null %}
                        <h5>Device binding matched by the cookie on this request</h5>
                        <table>
                            <tbody>
                                <tr><th scope="row" class="key" style="width: 220px;">Session identifier</th><td><code>{{ firewall.binding_session_id }}</code></td></tr>
                                <tr><th scope="row" class="key">User</th><td>{{ firewall.binding_user ?? '(none)' }}</td></tr>
                            </tbody>
                        </table>
                        <h6>Public key (JWK)</h6>
                        {{ helper.kv(firewall.binding_jwk) }}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
