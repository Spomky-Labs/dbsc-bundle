{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <span class="sf-toolbar-value">DBSC</span>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Registration requested</b>
            <span class="sf-toolbar-status sf-toolbar-status-{{ collector.registrationRequested ? 'green' : 'normal' }}">{{ collector.registrationRequested ? 'yes' : 'no' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Device-bound cookie</b>
            <span class="sf-toolbar-status sf-toolbar-status-{{ collector.cookiePresent ? 'green' : 'normal' }}">{{ collector.cookiePresent ? 'present' : 'absent' }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Firewalls</b>
            <span>{{ collector.data.firewalls|keys|join(', ') ?: '(none)' }}</span>
        </div>
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: true }) }}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.registrationRequested or collector.cookiePresent ? '' : 'disabled' }}">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <strong>DBSC</strong>
    </span>
{% endblock %}

{% block panel %}
    <h2>Device Bound Session Credentials</h2>

    <div class="metrics">
        <div class="metric">
            <span class="value">{{ collector.registrationRequested ? 'Yes' : 'No' }}</span>
            <span class="label">Registration requested</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.cookiePresent ? 'Present' : 'Absent' }}</span>
            <span class="label">Device-bound cookie</span>
        </div>
        <div class="metric">
            <span class="value">{{ collector.data.firewalls|length }}</span>
            <span class="label">Firewalls with DBSC</span>
        </div>
    </div>

    <h3>This request</h3>
    <table>
        <tbody>
            <tr>
                <th>Registration header</th>
                <td>{{ collector.registrationHeader ?? '(none)' }}</td>
            </tr>
            <tr>
                <th>Challenge</th>
                <td>{{ collector.data.challenge ?? '(none)' }}</td>
            </tr>
        </tbody>
    </table>

    {% if collector.data.firewalls is empty %}
        <p>No firewall enables <code>device_bound_session</code>.</p>
    {% endif %}

    {% for name, firewall in collector.data.firewalls %}
        <h3>Firewall <code>{{ name }}</code></h3>
        <table>
            <tbody>
                <tr>
                    <th>Cookie ({{ firewall.cookie_name }})</th>
                    <td>{{ firewall.cookie_present ? firewall.cookie_preview : '(not sent)' }}</td>
                </tr>
                <tr><th>Registration endpoint</th><td><code>{{ firewall.register_path }}</code></td></tr>
                <tr><th>Refresh endpoint</th><td><code>{{ firewall.refresh_path }}</code></td></tr>
                <tr><th>Algorithms</th><td>{{ firewall.algorithms|join(', ') }}</td></tr>
                <tr><th>Challenge TTL</th><td>{{ firewall.challenge_ttl }} s</td></tr>
                <tr><th>Mode</th><td>{{ firewall.authenticate ? 'full replacement (authenticate)' : 'additive' }}</td></tr>
                <tr><th>Binding repository</th><td><code>{{ firewall.binding_repository ?? '(n/a)' }}</code></td></tr>
                <tr><th>Challenge store</th><td><code>{{ firewall.challenge_store ?? '(n/a)' }}</code></td></tr>
            </tbody>
        </table>

        {% if firewall.binding_jwk is not null %}
            <h4>Device binding (this request)</h4>
            <table>
                <tbody>
                    <tr><th>Session identifier</th><td><code>{{ firewall.binding_session_id }}</code></td></tr>
                    <tr><th>User</th><td>{{ firewall.binding_user ?? '(none)' }}</td></tr>
                    <tr>
                        <th>Public key (JWK)</th>
                        <td><pre style="white-space: pre-wrap;">{{ firewall.binding_jwk|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre></td>
                    </tr>
                </tbody>
            </table>
        {% endif %}
    {% endfor %}
{% endblock %}
